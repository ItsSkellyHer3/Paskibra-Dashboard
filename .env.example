# Copy to .env for a service manager that loads dotenv-style EnvironmentFile.
# Generate a private value with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-long-random-secret

# Set only for initial Owner account creation, then remove after setup.
# PASKIBRA_OWNER_PASSWORD=replace-with-a-strong-password

# Optional Web Push settings. The app creates instance/vapid_private.pem if omitted.
# VAPID_SUBJECT=mailto:admin@example.org
