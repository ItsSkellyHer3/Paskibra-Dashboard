[Unit]
Description=Paskibra V2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adhyastha
WorkingDirectory=/home/adhyastha/paskibra_v2
EnvironmentFile=-/home/adhyastha/paskibra_v2/.env
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/adhyastha/paskibra_v2/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
